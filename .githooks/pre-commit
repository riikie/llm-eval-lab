#!/usr/bin/env bash
# 提交前敏感信息扫描：命中即拒绝提交。
# 命中后请修改文件再重新 git add —— 不要用 --no-verify 绕过。
set -uo pipefail

# 手机号 / QQ 号邮箱 / 18 位身份证号 / key-secret-token-password 赋值
PAT='1[3-9][0-9]{9}|[0-9]{5,11}@qq\.com|[1-9][0-9]{5}(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]|(api[_-]?key|secret|token|password|passwd)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9_/+.-]{8,}'

hits=$(git diff --cached -U0 -- . ':(exclude).githooks' | grep -nE "$PAT" || true)

if [ -n "$hits" ]; then
  echo "[pre-commit] 暂存区疑似含敏感信息，提交已拒绝："
  echo "$hits"
  echo "处理：改掉命中的值后 git add 重来，或把文件加进 .gitignore。"
  exit 1
fi

exit 0
